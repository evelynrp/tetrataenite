[Unit]
Description=tetrataenite flatpak setup
Wants=network-online.target
After=network-online.target
ConditionUser=!@system
ConditionPathIsDirectory=/var/home/%u
# Run if either step is still pending; the script writes both stamps itself.
ConditionPathExists=|!%E/tetrataenite/tetrataenite-flatpak-setup.stamp
ConditionPathExists=|!%E/tetrataenite/tetrataenite-flatpak-migration.stamp

[Service]
Type=oneshot
ExecStart=/usr/libexec/tetrataeniteflatpaksetup
Restart=on-failure
RestartSec=30s
RestartMaxDelaySec=1800s
RestartSteps=10
