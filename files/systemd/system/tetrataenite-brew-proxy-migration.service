[Unit]
Description=Migration service to new Homebrew setup with brew-proxy
Wants=multi-user.target
After=multi-user.target
ConditionPathExists=!/var/lib/tetrataenite/tetrataenite-brew-proxy-migration.stamp

[Service]
Type=oneshot
StateDirectory=tetrataenite
ExecStart=/usr/libexec/brew-proxy-migration

[Install]
WantedBy=multi-user.target